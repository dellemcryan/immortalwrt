-CONFIG_SHA512=y
-CONFIG_PHY_AIROHA_EN8811=y
-CONFIG_PHY_ANEG_TIMEOUT=10000
-CONFIG_PHY_ETHERNET_ID=y
 CONFIG_USE_DEFAULT_ENV_FILE=y
 CONFIG_DEFAULT_ENV_FILE="defenvs/an7583_nokia_xg-040g-mf_env"
